$(document).ready(function(){ 
    
    $('#menu ul').children('li').each(function()
    {
        var submenu = $(this).children('ul');

        if(submenu.parents("ul").length != 1 && submenu.parents("ul").length > 0)//yani li haye avali naboodand
        {
            $(this).addClass('has_childeren');
        }
    }); 

    /*
    $('#menu ul').children('li').hover
    (
        function()
        {
            $(this).children('ul').css('display', 'none').removeClass('menu_li_hover'); 
            $(this).addClass('menu_li_hover');
            var submenu = $(this).children('ul');

            if(submenu[0])
            {
                if(submenu.parents("ul").length != 1)//yani li haye avali naboodand
                {
                    var parent = submenu.parents("ul").width();
                    submenu.css({'margin-right':(parent)+'px' }); // defult 25
                }
                else
                { 
                    $(this).addClass('first_li_hover');
                }
                submenu.show(150);
                //submenu.css('display', 'block');
            }		
    	} , 
        function()
        {
            $(this).children('ul').css('display', 'none'); 	
            $(this).removeClass('menu_li_hover');
            $(this).removeClass('first_li_hover');
    	}
    );
    */
    
    function showMenu()
    {
        $('#menu ul').children('li').removeClass('menu_li_hover');
        $(this).addClass('menu_li_hover');
        //$(this).children('ul').css('display', 'none').removeClass('menu_li_hover'); 
        var submenu = $(this).children('ul');
        var parent_menu = $(this);

        if(submenu[0])
        {
            if(submenu.parents("ul").length != 1)//yani li haye avali naboodand
            {
                var parent = submenu.parents("ul").width();
                if($(submenu).width() > $(parent_menu).offset().left ){
                    var left = $(submenu).width();
                    var top =  $(submenu).offset().top;
                    $(submenu).css({top:top,right:-left,position:'absolute'});
                }
                else {
                    submenu.css({'margin-right':(parent)+'px' }); // defult 25
                }
            
            }
            else
            { 
                $(this).addClass('first_li_hover');
            }
            submenu.show(150);
        }		
	}
    function hideMenu()
    {
        $(this).children('ul').css('display', 'none');
        $(this).removeClass('menu_li_hover');
        $(this).removeClass('first_li_hover');
	}   
     
    $('#menu ul').children('li').hoverIntent({
        over: showMenu, 
        timeout: 700,
        //sensitivity: 1, // number = sensitivity threshold (must be 1 or higher)    
        //interval: 200, // number = milliseconds for onMouseOver polling interval         
        out: hideMenu
	});
      
     

});