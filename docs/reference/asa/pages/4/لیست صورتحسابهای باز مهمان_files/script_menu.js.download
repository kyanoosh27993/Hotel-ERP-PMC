function command_promop(srcElem, e)
{
    if(e)
    {
        var evt = e || window.event;
        evt.preventDefault();
    }
    
    var val_cmd = $.trim($('#'+srcElem).val());
    var len_val = val_cmd.length;
    
    var patern2 = /^[1-9]\d*$/; 
    var res = val_cmd.match(patern2);
    if( ! res)
    {
        $('#'+srcElem).val('منو مشخص نیست').focus().select();
        return;
    }   
    if(len_val > 3 || len_val <= 1)
    {
        $('#'+srcElem).val('طول عدد باید بین 2 تا 3 باشد').focus().select();
        return;
    }  
    
    var level1 = val_cmd.substr(0, 1);
    var level2 = val_cmd.substr(1, 1);
    var level3 = val_cmd.substr(2, 1); 
                              
    switch(len_val)
    {
        case 3:
        {
            if(level3 > 0)
            {
                //level3 -= 1; 
            } 
            var address = $(".level_"+level1+" .level_"+level1+"_"+level2+" li:eq("+level3+")").find('a').attr('href');
            
            if((typeof address == 'undefined') || (address == '' || address == '#') )
            {
                $('#'+srcElem).val('منو صحیح نمی باشد').focus().select();
                return;
            }                                                
            document.location = address;
        }
        break;
        case 2:
        {
            if(level2 > 0)
            {
                //level2 -= 1; 
            }   
            
            var counter = -1;
            $(".level_"+level1+" li").each(function(){
                if($(this).parents('ul').length < 3)
                {
                    counter++;
                    if(counter == level2)
                    {
                        if($(this).find('a').attr('href') != '#')
                        {
                            document.location = $(this).find('a').attr('href');
                        }
                        return;
                    }
                }
            });
            
            setTimeout(function(){
                
                $('#'+srcElem).val('منو صحیح نمی باشد').focus().select(); 
                                           
            }, 450);                                         
        } 
        break;
    }   
    
}    
