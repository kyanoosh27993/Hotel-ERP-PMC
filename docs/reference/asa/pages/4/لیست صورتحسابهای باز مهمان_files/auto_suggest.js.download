function gate_entry(e,myfield,url,kind_fill,_country)
{
	if(kind_fill == '' || kind_fill == null || kind_fill == 'null')
    {
        kind_fill = 0;
    }
    //--------------------------
    inputString = myfield.value;
    //----------------------
    evt = e || window.event;
    var key = evt.which || evt.keyCode;
    //-------------------------
    if(inputString.length == 0) 
    {
        $('#suggestions').fadeOut();
    } 
    else 
    {
        if(key != 38 && key != 40 && key != 13)
        {
            $.post(url,{queryString:inputString,kind_fill:kind_fill,_country:_country},function(data)
            {          
                //----------------------
                if(data.counter == 0)//یعنی هیچ دیتایی نیست
                {
                    fill(data.data_rsv,0,2,kind_fill);// یعنی برو کلاس error را نشان بده
                }
                else
                {
                    if(data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
                    {
                        $('#suggestions').fadeIn();
                        //--------------------------------------------------
                    	var offset_top = $("#"+myfield.name).offset().top+27;
                    	var offset_left = $("#"+myfield.name).offset().left-15;
                    	$("div.suggestionsBox").css({"top":offset_top,"left":offset_left});
                        //-----------------------------------------
                        $('#suggestionsList').html(data.data_rsv);
                        $(".suggestionList ul li").hover(
                            function(){
                                $(this).css({'background-color':'#FFFF00','font-weight':'bold'}); 
                            },
                            function(){
                                $(this).css({'background-color':'#F0F8FF','font-weight':'normal'}); 
                            }
                        );
                    }
                    else // یعنی دیتا یکی است
                    {
                        fill(data.data_rsv,data.id_data,1,kind_fill);
                    }
                }                   
            },"json");
        }
        else
        {
            get_child(key);    
        }
    }
}

//---------------------------------------------------------------------------------
function suggest_goods_request_new2(e, myfield, _storage, _radif, lang_align, _language)
{
    inputString = myfield.value;
	//alert(inputString);
    //----------------------
    var evt = e || window.event;
    var key = evt.keyCode;
    //-------------------------
    if(inputString.length == 0) 
    {
        $('#suggestions').fadeOut();
    } 
    else 
    {
        $("#"+myfield.name).addClass("loading");
        if(key != 38 && key != 40 && key != 13)
        {
            $.post("../suggest/goods_request_new2_suggest.php", {
                queryString: inputString,
                _storage: _storage,
                _radif: _radif,
                lang_align: lang_align,
                _language: _language
            }, function (data)
            {                
                //----------------------
                if(data.counter == 0)//یعنی هیچ دیتایی نیست
                {
                    $("#"+myfield.name).removeClass("loading");
                    fill('','','','','','','',_radif,2);// یعنی برو کلاس error را نشان بده
                }
                else
                {
                    if(data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
                    {
                        $("#"+myfield.name).removeClass("loading");
                        $('#suggestions').fadeIn();
                        //--------------------------------------------------
                    	var offset_top = $("#"+myfield.name).offset().top+27;
                    	var offset_left = $("#"+myfield.name).offset().left-95;
                    	$("div.suggestionsBox").css({"top":offset_top,"left":offset_left});
                        //-----------------------------------------
                        $('#suggestionsList').html(data.data_rsv);
                        $(".suggestionList ul li").hover(
                            function(){
                                $(this).css({'background-color':'#FFFF00','font-weight':'bold'}); 
                            },
                            function(){
                                $(this).css({'background-color':'#F0F8FF','font-weight':'normal'}); 
                            }
                        );
                    }
                    else // یعنی دیتا یکی است
                    {
                        $("#"+myfield.name).removeClass("loading");
                        fill(   data.code_s,
                                data._codeid,
                                data.name,
                                data.test_valid,
                                data._unit,
                                data._amont,
                                data._amont_,
                                data.radiff,
                                1,
                                data.New_Storage,
                                data.has_decimal
                            );
                    }
                }                   
            },"json");
        }
        else
        {
            $("#"+myfield.name).removeClass("loading");
            get_child(key);    
        }
    }
}
//--------------------------------------------------------------------------------------------------
function suggest_engin_receipt_new0(e, myfield, _storage, _rsv_date, _radif, Codding_Storage, lang_align, _language)
{
    inputString = myfield.value;
    //----------------------
    var evt = e || window.event;
    var key = evt.keyCode;
    //-------------------------
    if(inputString.length == 0) 
    {
        //$("#"+myfield.name).removeClass("loading");
        fill('', '', '', '', '', '', '', _radif, 2);// یعنی برو کلاس error را نشان بده
        $('#suggestions').fadeOut();
    } 
    else 
    {
        $("#"+myfield.name).addClass("loading");
        if(key != 38 && key != 40 && key != 13)
        {
            $.post("../suggest/engin_receipt_new0_suggest.php", {
                queryString: inputString,
                _storage: _storage,
                _radif: _radif,
                _rsv_date: _rsv_date,
                Codding_Storage: Codding_Storage,
                lang_align: lang_align,
                _language: _language
            }, function (data)
            {                
                //----------------------
                if(data.counter == 0)//یعنی هیچ دیتایی نیست
                {
                    $("#"+myfield.name).removeClass("loading");
                    fill('', '', '', '', '', '', '', _radif, 2);// یعنی برو کلاس error را نشان بده
                }
                else
                {
                    if(data.counter > 1)//یعنی تعداد دیتا بیش از یک رکورد است
                    {
                        $("#"+myfield.name).removeClass("loading");
                        $('#suggestions').fadeIn();
                        //-------------------------------------------------------
                    	var offset_top = $("#"+myfield.name).offset().top+27;
                    	var offset_left = $("#"+myfield.name).offset().left-95;
                    	$("div.suggestionsBox").css({"top":offset_top,"left":offset_left});
                        //-----------------------------------------
                        $('#suggestionsList').html(data.data_rsv);
                        $(".suggestionList ul li").hover(
                            function(){
                                $(this).css({'background-color':'#FFFF00','font-weight':'bold'}); 
                            },
                            function(){
                                $(this).css({'background-color':'#F0F8FF','font-weight':'normal'}); 
                            }
                        );
                    }
                    else // یعنی دیتا یکی است
                    {
                        $("#"+myfield.name).removeClass("loading");
                        fill(   data.code_s,
                                data._codeid,
                                data.name,
                                data.test_valid,
                                data._unit,
                                data._amont,
                            	data.txt_fiee,
                                data.radiff,
                                1
                            );
                    }
                }                   
            },"json");
        }
        else
        {
            $("#"+myfield.name).removeClass("loading");
            get_child_list(key);    
        }
    }
}
