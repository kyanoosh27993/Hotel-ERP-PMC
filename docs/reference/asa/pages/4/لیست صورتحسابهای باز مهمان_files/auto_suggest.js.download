function suggest_receipt_input_new3(e,myfield,_storage,_radif,test_kind,Codding_Storage,lang_align,_language,use_codes)
{
    inputString = myfield.value;
    //----------------------
    var evt = e || window.event;
    var key = evt.keyCode;
    var url = '';
    //-------------------------
    if(inputString.length == 0) 
    {
        $('#suggestions').fadeOut();
    } 
    else 
    {
        $("#"+myfield.name).addClass("loading");
        if(key != 38 && key != 40 && key != 13)
        {
            if (test_kind == 'has_one')
                url = "../suggest/seller_suggest_2.php";
            else
                url = "../suggest/receipt_input_new3_suggest.php";
            
            $.post(url,{queryString:inputString,_storage:_storage,_radif:_radif,test_kind:test_kind,Codding_Storage:Codding_Storage,lang_align:lang_align,_language:_language,use_codes:use_codes},function(data)
            {                
                //----------------------
                if(data.counter == 0)//یعنی هیچ دیتایی نیست
                {
                    $("#"+myfield.name).removeClass("loading");
                    fill('','','','','','','','','','','','','','','','','',_radif,test_kind,2);// یعنی برو کلاس error را نشان بده
                }
                else
                {
                    if(data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
                    {
                        $("#"+myfield.name).removeClass("loading");
                        $('#suggestions').fadeIn();
                        //--------------------------------------------------
                    	var offset_top = $("#"+myfield.name).offset().top+27;
                    	var offset_left = $("#"+myfield.name).offset().left-30;
                    	$("div.suggestionsBox").css({"top":offset_top,"left":offset_left});
                        //-----------------------------------------
                        $('#suggestionsList').html(data.data_rsv);
                        $(".suggestionList ul li").hover(
                            function(){
                                $(this).css({'background-color':'#FFFF00','font-weight':'bold'}); 
                            },
                            function(){
                                $(this).css({'background-color':'#F0F8FF','font-weight':'normal'}); 
                            }
                        );
                    }
                    else // یعنی دیتا یکی است
                    {
                        $("#"+myfield.name).removeClass("loading");
                        fill(   data.code_s,
                                data._codeid,
                                data.name,
                                data.test_valid,
                                data._unit1,
                                data._unit1_id,
                                data._unit2,
                                data._unit2_id,
                                data._unit3,
                                data._unit3_id,
                                data.conversion_factor,
                                data.conversion_factor_kind,
                                data.conversion_factor2,
                                data.conversion_factor_kind2,
                                data._avrg,
                                data._amont,
                                data._amont_,
                                data.radiff,
                                test_kind,
                                1,
                                data.date_control_val
                            );
                    }
                }                   
            },"json");
        }
        else
        {
            $("#"+myfield.name).removeClass("loading");
            get_child(key);    
        }
    }
}
