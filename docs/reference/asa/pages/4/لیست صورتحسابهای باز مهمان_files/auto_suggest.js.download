            {
                //----------------------
                if(data.counter == 0)//یعنی هیچ دیتایی نیست
                {
                    //alert('lang='+data.lang_align);
                    $("#"+myfield.name).removeClass("loading");
                    fill('','','','','','','',_radif,2);// یعنی برو کلاس error را نشان بده
                }
                else
                {
                    if(data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
                    {
                        $("#"+myfield.name).removeClass("loading");
                        $('#suggestions').fadeIn();
                        //--------------------------------------------------
                        var el_height = $("#"+myfield.name).height();
                        var el_width = $("#"+myfield.name).width();
                        
                        /*var offset_top = $("#"+myfield.name).position().top+el_height;
                    	var offset_left = $("#"+myfield.name).position().left;*/
                        var offset_top = $("#"+myfield.name).offset().top+el_height;
                        var offset_left = $("#"+myfield.name).offset().left;
                        $("div.suggestionsBox").css({"top":offset_top,"left":offset_left,"width":el_width});
                        $("div.suggestionsBox").css({"top":offset_top,"left":offset_left});
                        //-----------------------------------------
                        $('#suggestionsList').html(data.data_rsv);
                        $(".suggestionList ul li").hover(
                            function(){
                                $(this).css({'background-color':'#FFFF00','font-weight':'bold'});
                            },
                            function(){
                                $(this).css({'background-color':'#F0F8FF','font-weight':'normal'});
                            }
                        );
                    }
                    else // یعنی دیتا یکی است
                    {
                        $("#"+myfield.name).removeClass("loading");
                        fill(data.code_s,
                            data._codeid,
                            data.name,
                            data.test_valid,
                            data._unit1,
                            data._unit1_id,
                            data._unit2,
                            data.radiff,
                            1
                        );
                    }
                }
            },"json");
        }
        else
        {
            $("#"+myfield.name).removeClass("loading");
            get_child(key);
        }
    }
}
//-------------------------------------------------------------------------
function task_manager_suggest(e,myfield,url,kind_fill,lang_align,_language)
{
    if(kind_fill == '' || kind_fill == null || kind_fill == 'null')
    {
        kind_fill = 0;
    }
    //--------------------------
    inputString = myfield.value;
    //----------------------
    evt = e || window.event;
    var key = evt.which || evt.keyCode;
    //-------------------------
    if(inputString.length == 0) 
    {
        $('#suggestions').fadeOut();
    } 
    else 
    {
        if(key != 38 && key != 40 && key != 13)
        {            
            $.post(url,{queryString:inputString,kind_fill:kind_fill,lang_align:lang_align,_language:_language},function(data)
            {
                //----------------------
                if(data.counter == 0)//یعنی هیچ دیتایی نیست
                {
                    fill_1(data.data_rsv,0,0,0,0);// یعنی برو کلاس error را نشان بده
                }
                else
                {
                    if(data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
                    {
                        $('#suggestions').fadeIn();
                        //--------------------------------------------------
                        var el_height = $("#"+myfield.name).height();
                        var el_width = $("#"+myfield.name).width();
                        var offset_top = $("#"+myfield.name).offset().top+el_height;
                        var offset_left = $("#"+myfield.name).offset().left;
                        $("div.suggestionsBox").css({"top":offset_top,"left":offset_left,"width":el_width});
                        //-----------------------------------------
                        $('#suggestionsList').html(data.data_rsv);
                        $(".suggestionList ul li").hover(
                            function(){
                                $(this).css({'background-color':'#FFFF00','font-weight':'bold'}); 
                            },
                            function(){
                                $(this).css({'background-color':'#F0F8FF','font-weight':'normal'}); 
                            }
                        );
                    }
                    else // یعنی دیتا یکی است
                    {
                        fill_1(data.data_rsv,data.id_data,data.input_activity,data.kind_fill,1);
                    }
                }                   
            },"json");
        }
        else
        {
            get_child(key);    
        }
    }
}
