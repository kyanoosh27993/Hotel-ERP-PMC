//----------------------------------------------------
function foods_suggest(e,myfield,lang_align,_language)
{
    //--------------------------
    inputString = myfield.value;
    //----------------------
    evt = e || window.event;
    var key = evt.which || evt.keyCode;
    //-------------------------
    if(inputString.length == 0) 
    {
        $('#suggestions').fadeOut();
    } 
    else 
    {
        if(key != 38 && key != 40 && key != 13)
        {
            $.post('../suggest/foods_suggest.php', 
            {
                queryString: inputString,
                lang_align: lang_align,
                _language: _language
            }, function (data)
            {
                //----------------------
                if(data.counter == 0)//یعنی هیچ دیتایی نیست
                {
                    fill(data.data_rsv,0,2,0);// یعنی برو کلاس error را نشان بده
                }
                else
                {
                    if(data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
                    {
                        $('#suggestions').fadeIn();
                        //--------------------------------------------------
                        var offset_top = $("#"+myfield.name).offset().top+27;
                        var offset_left = $("#"+myfield.name).offset().left-150;
                        $("div.suggestionsBox").css({"top":offset_top,"left":offset_left});
                        //-----------------------------------------
                        $('#suggestionsList').html(data.data_rsv);
                        $(".suggestionList ul li").hover(
                            function(){
                                $(this).css({'background-color':'#FFFF00','font-weight':'bold'}); 
                            },
                            function(){
                                $(this).css({'background-color':'#F0F8FF','font-weight':'normal'}); 
                            }
                        );
                    }
                    else // یعنی دیتا یکی است
                    {
                        fill(data.data_rsv,data.id_data,data.id_code,1);
                    }
                }                   
            },"json");
        }
        else
        {
            get_child(key);    
        }
    }
    // Hide it after finishing ajax request
    $("#"+myfield.id).LoadingOverlay("hide");
    // $.LoadingOverlay("hide");

}

function suggest_location(e, myfield, url, lang_align, _language)
{
    //--------------------------
    inputString = myfield.value;
    //----------------------
    evt = e || window.event;
    var key = evt.which || evt.keyCode;
    //-------------------------
    if(inputString.length == 0) 
    {
        $('#suggestions').fadeOut();
    } 
    else 
    {
        if(key != 38 && key != 40 && key != 13)
        {

            $.post(url, {queryString: inputString, lang_align: lang_align, _language: _language}, function (data)
            {
                //alert(data.query);

                //----------------------
                if(data.counter == 0)//یعنی هیچ دیتایی نیست
                {
                    fill_1(data.data_rsv,0,0,0,0,0);// یعنی برو کلاس error را نشان بده
                }
                else
                {
                    if(data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
                    {
                        $('#suggestions').fadeIn();
                        //--------------------------------------------------
                        var offset_top = $("#"+myfield.name).offset().top+27;
                        var offset_left = $("#"+myfield.name).offset().left-15;
                        $("div.suggestionsBox").css({"top":offset_top,"left":offset_left});
                        //-----------------------------------------
                        $('#suggestionsList').html(data.data_rsv);
                        $(".suggestionList ul li").hover(
                            function(){
                                $(this).css({'background-color':'#FFFF00','font-weight':'bold'}); 
                            },
                            function(){
                                $(this).css({'background-color':'#F0F8FF','font-weight':'normal'}); 
                            }
                        );
                    }
                    else // یعنی دیتا یکی است
                    {
                        fill_1(data._id,data._name,data.room_id,data._room,1,data._code);
                    }
                }                   
            },"json");
        }
        else
        {
            get_child(key);    
        }
    }
    // Hide it after finishing ajax request
    $("#"+myfield.id).LoadingOverlay("hide");
    // $.LoadingOverlay("hide");

}
function suggest_search_name1(name,sur_name,rdf_search,kind_search,lang_align,lang_directory)
{
    $('#action').val('Waiting').attr("disabled",1);
    $.post("../suggest/search_name1_suggest.php",{name:name,sur_name:sur_name,rdf_search:rdf_search,kind_search:kind_search,lang_align:lang_align,lang_directory:lang_directory},function(data)
    {                                           
        //----------------------
        if(data.counter == 0) // یعنی هیچ دیتایی نیست
        {
            $('#suggestionsList_list_3').hide("fast");
            if (lang_align>0)
            {
	            $("div#error_log").show("fast").html("Empty record");
	            $('#action').val('Submit');
            }
            else
            {
	            $("div#error_log").show("fast").html("رکوردی برای نمایش وجود ندارد");
	            $('#action').val('  ثبت شود  ');
            }
            document.getElementById('action').disabled=0;
        }
        else
        {   
            if(data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
            {
                $("div#error_log").hide();
                $('#suggestionsList_list_3').html(data.data_rsv).show("fast");
                if (lang_align>0)
                	$('#action').val('Submit');
                else
                	$('#action').val('  ثبت شود  ');
                	
	            document.getElementById('action').disabled=0;
            }
        }                
    },"json");
}

//------------------------------------------------------------------
function suggest(e, myfield, url, kind_fill, lang_align, _language, _date)
{
    if(kind_fill == '' || kind_fill == null || kind_fill == 'null')
    {
        kind_fill = 0;
    }
    //--------------------------
    inputString = myfield.value;
    //----------------------
    evt = e || window.event;
    var key = evt.which || evt.keyCode;
    //-------------------------
    if(inputString.length == 0) 
    {
        $('#suggestions').fadeOut();
    } 
    else 
    {
        if(key != 38 && key != 40 && key != 13)
        {
            $.post(url, {
                queryString: inputString,
                kind_fill: kind_fill,
                lang_align: lang_align,
                _language: _language,
                _date: _date
            }, function (data)
            {
                //alert(data.query);

            	//----------------------
            	if(data.counter == 0)//یعنی هیچ دیتایی نیست
                {
                	fill(data.data_rsv,0,2,kind_fill);// یعنی برو کلاس error را نشان بده
                }
                else
                {
                    if(data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
                    {
                        $('#suggestions').fadeIn();
                        //--------------------------------------------------
                    	var offset_top = $("#"+myfield.name).offset().top+27;
                    	var offset_left = $("#"+myfield.name).offset().left-150;
                    	$("div.suggestionsBox").css({"top":offset_top,"left":offset_left});
                        //-----------------------------------------
                        $('#suggestionsList').html(data.data_rsv);
                        $(".suggestionList ul li").hover(
                            function(){
                                $(this).css({'background-color':'#FFFF00','font-weight':'bold'}); 
                            },
                            function(){
                                $(this).css({'background-color':'#F0F8FF','font-weight':'normal'}); 
                            }
                        );
                    }
                    else // یعنی دیتا یکی است
                    {
                    	fill(data.data_rsv,data.id_data,1,kind_fill);
                    }
                }                   
            },"json");
        }
        else
        {
            get_child(key);    
        }
    }
    // Hide it after finishing ajax request
    $("#"+myfield.id).LoadingOverlay("hide");
    // $.LoadingOverlay("hide");

}

//------------------------------------------------
function suggest_asset(e, myfield, url, kind_fill)
{
    if(kind_fill == '' || kind_fill == null || kind_fill == 'null')
    {
        kind_fill = 0;
    }
    //--------------------------
    inputString = myfield.value;
    //----------------------
    evt = e || window.event;
    var key = evt.which || evt.keyCode;
    //-------------------------
    if(inputString.length == 0) 
    {
        $('#suggestions').fadeOut();
    } 
    else 
    {
        if(key != 38 && key != 40 && key != 13)
        {
            $.post(url, {queryString: inputString, kind_fill: kind_fill}, function (data)
            {                
                //----------------------
                if(data.counter == 0)//یعنی هیچ دیتایی نیست
                {
                	if (kind_fill==1)
                		fill(data.data_rsv,0,2,kind_fill);// یعنی برو کلاس error را نشان بده
                   	if (kind_fill==2)
                		fill_1(data.data_rsv,0,2,kind_fill);// یعنی برو کلاس error را نشان بده
                }
                else
                {
                    if(data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
                    {
                        $('#suggestions').fadeIn();
                        //--------------------------------------------------
                    	var offset_top = $("#"+myfield.name).offset().top+27;
                    	var offset_left = $("#"+myfield.name).offset().left-15;
                    	$("div.suggestionsBox").css({"top":offset_top,"left":offset_left});
                        //-----------------------------------------
                        $('#suggestionsList').html(data.data_rsv);
                        $(".suggestionList ul li").hover(
                            function(){
                                $(this).css({'background-color':'#FFFF00','font-weight':'bold'}); 
                            },
                            function(){
                                $(this).css({'background-color':'#F0F8FF','font-weight':'normal'}); 
                            }
                        );
                    }
                    else // یعنی دیتا یکی است
                    {
                    	if (kind_fill==1)
                    		fill(data.data_rsv,data.id_data,1,kind_fill);
                    	if (kind_fill==2)
                    		fill_1(data.data_rsv,data.id_data,1,kind_fill);
                    }
                }                   
            },"json");
        }
        else
        {
            get_child(key);    
        }
    }
}
