        {
            $.post(url,{queryString:inputString,rate_tour_calc_status:rate_tour_calc_status,lang_align:lang_align},function(data)
            {                
                //----------------------
                if(data.counter == 0)//یعنی هیچ دیتایی نیست
                {
                    fill(0,0,0,0,0,2);// یعنی برو کلاس error را نشان بده
