//----------------------------
function get_child_list(event)
{
    $(".list tr .selected").removeClass("selected");
    var found = 0;
    //-----------------------
    switch(event)
    {
        case 40:// arrow down 
        {
            $(".list tr").each(function()
            {
                if($(this).attr("class") == "selected")
                    found = 1; 	
            });
            if(found == 1)
            {
                var sel = $(".list tr[class='selected']");
                //--------------------------
                if(sel.next().text() == "")					
                    $(".list tr:first").addClass("selected");
                else
                    sel.next().addClass("selected");
                
                // remove class selected from previous item
                sel.removeClass("selected");
            }
            else
                $(".list tr:first").addClass("selected"); 
        }
        break;
        case 38:// arrow up
        {
            $(".list tr").each(function()
            {
                if($(this).attr("class") == "selected")
                    found = 1;
            });
            if(found == 1)
            {
                var sel = $(".list tr[class='selected']");
                if(sel.prev().text() == "")					
                    $(".list tr:last").addClass("selected");
                else
                    sel.prev().addClass("selected");
                // remove class selected from previous item
                sel.removeClass("selected");
            }
            else
                $(".list tr:last").addClass("selected");
        }
        break;
        case 13:// enter
        {
            $(".list tr[class='selected']").click();
        }
    }
}
//-----------------------
function get_child(event)
{
    $(".list li .selected").removeClass("selected");
    var found = 0;
    //-----------------------
    switch(event)
    {
        case 40:// arrow down 
        {
            $(".list li").each(function()
            {
                if($(this).attr("class") == "selected")
                    found = 1; 	
            });
            if(found == 1)
            {
                var sel = $(".list li[class='selected']");
                //--------------------------
                if(sel.next().text() == "")					
                    $(".list li:first").addClass("selected");
                else
                    sel.next().addClass("selected");
                
                // remove class selected from previous item
                sel.removeClass("selected");
            }
            else
                $(".list li:first").addClass("selected"); 
        }
        break;
        case 38:// arrow up
        {
            $(".list li").each(function()
            {
                if($(this).attr("class") == "selected")
                    found = 1;
            });
            if(found == 1)
            {
                var sel = $(".list li[class='selected']");
                if(sel.prev().text() == "")					
                    $(".list li:last").addClass("selected");
                else
                    sel.prev().addClass("selected");
                // remove class selected from previous item
                sel.removeClass("selected");
            }
            else
                $(".list li:last").addClass("selected");
        }
        break;
        case 13:// enter
        {
            $(".list li[class='selected']").click();
        }
    }
}
