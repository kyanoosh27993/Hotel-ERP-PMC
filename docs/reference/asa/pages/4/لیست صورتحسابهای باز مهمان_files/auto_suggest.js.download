                            }
                        );
                    }
                    else // یعنی دیتا یکی است
                    {
                        fill(data.data_rsv,data.id_data,data.test_valid,data.Full_Board_Person_Rate2,data.Full_Board_Person_Dolar,1);
                    }
                }                   
            },"json");
        }
        else
        {
            get_child(key);    
        }
    }
}
//------------------------------------------------
function suggest_list(e, myfield, url, kind)
{ 
    inputString = myfield.value;
    name_input = myfield.name;
    //----------------------
    evt = e || window.event;
    var key = evt.which || evt.keyCode;
    //-------------------------
    if(inputString.length == 0) 
    {
        $('#suggestions').fadeOut();
    } 
    else 
    {
        $("#"+name_input).addClass("loading");
        //------------------------------------
        if(key != 38 && key != 40 && key != 13)
        {
            $.post(url, {queryString: inputString, kind: kind}, function (data)
            {                              
                //----------------------
                if(data.counter == 0) // یعنی هیچ دیتایی نیست
                {
                    $("#"+name_input).removeClass("loading");
                    $('#suggestionsList_list_1').hide("fast");
                    $("div#error_log").show("fast").html("رکوردی برای نمایش وجود ندارد");
                }
                else
                {
                    if(data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
                    {
                        $("div#error_log").hide();
                        $("#"+name_input).removeClass("loading");
                        $('#suggestionsList_list_1').html(data.data_rsv).show("fast");
                    }
                    else // یعنی دیتا یکی است
                    {
                        $("#"+name_input).removeClass("loading");
                        fill(data.data_rsv,data.id_data,1);
                    }
                }                
            },"json");//
        }
        else
        {
            $("#"+name_input).removeClass("loading");
            get_child_list(key);    
        }
    }
}
