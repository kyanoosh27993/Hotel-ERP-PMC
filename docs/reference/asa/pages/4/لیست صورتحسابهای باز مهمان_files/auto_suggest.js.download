function suggest_amount_cash(e, myfield, url, kind, date1, date2, _reference, _desc)
{
    inputString = myfield.value.replace(/,/g, '');
    name_input = myfield.name;
    //----------------------
    evt = e || window.event;
    var key = evt.which || evt.keyCode;
    //-------------------------
    $("#" + name_input).addClass("loading");
    //-------------------------------------
    if (key != 38 && key != 40 && key != 13)
    {
        $.post(url, {
            queryString: inputString,
            kind: kind,
            date1: date1,
            date2: date2,
            _reference: _reference,
            _desc: _desc
        }, function (data)
        {
            //----------------------
            if (data.counter == 0) // یعنی هیچ دیتایی نیست
            {
                $("#" + name_input).removeClass("loading");
                $('#suggestionsList_list_3').hide("fast");
                $("div#error_log").show("fast").html("رکوردی برای نمایش وجود ندارد");
                $("#action").fadeIn();
            } else
            {
                if (data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
                {
                    $("div#error_log").hide();
                    $("#" + name_input).removeClass("loading");
                    $('#suggestionsList_list_3').html(data.data_rsv).show("fast");
                    $("#action").fadeIn();
                }
            }
        }, "json");
    } else
    {
        $("#" + name_input).removeClass("loading");
        get_child_list(key);
    }
}

