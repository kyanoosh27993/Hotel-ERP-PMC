function task_location_suggest(e,myfield,url,kind_fill,lang_align,_language)
{
    if(kind_fill == '' || kind_fill == null || kind_fill == 'null')
    {
        kind_fill = 0;
    }
    //--------------------------
    inputString = myfield.value;
    //----------------------
    evt = e || window.event;
    var key = evt.which || evt.keyCode;
    //-------------------------
    if(inputString.length == 0) 
    {
        $('#suggestions').fadeOut();
    } 
    else 
    {
        if(key != 38 && key != 40 && key != 13)
        {            
            $.post(url,{queryString:inputString,kind_fill:kind_fill,lang_align:lang_align,_language:_language},function(data)
            {
                //----------------------
                if(data.counter == 0)//یعنی هیچ دیتایی نیست
                {
                    fill_2(data.data_rsv,0,0,0,0,0);// یعنی برو کلاس error را نشان بده
                }
                else
                {
                    if(data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
