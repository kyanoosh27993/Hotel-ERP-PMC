function account1_suggest(e, myfield, txt_st, kind_fill, send_account_incoming, ignore, lang_align, _language)
{
    if(ignore == 1)
        return true;
    //--------------------------
    inputString = myfield.value;
    //----------------------
    evt = e || window.event;
    var key = evt.which || evt.keyCode;
    var index_tafzily=0;
    //-------------------------
    if(key == 8 || key == 39 || key == 37 || key == 46 || key == 16 || key == 9)
    {
    	return;
    }
    if(inputString.length == 0) 
    {
        $('#suggestions').fadeOut();
    } 
    else 
    {
        if(key != 38 && key != 40 && key != 13)
        {
            switch(txt_st)
            {
                case '_account1_url':
                    url = "../suggest/account1_suggest_1.php";
                break;
                case '_compar1_url':
                    var n=e.target.name;
                    var list_tafzily=n.split('_');
                    index_tafzily=list_tafzily[list_tafzily.length-1];
                    url = "../suggest/compar1_suggest_1.php";
                break;
                case '_compar2_url':
                    url = "../suggest/compar2_suggest_1.php";
                break;
                case 'shahr_url':
                    url = "../suggest/shahr_suggest_1.php";
                break;
                case '_compar12_url':
                    var n=e.target.name;
                    var list_tafzily=n.split('_');
                    var index_tafzily=list_tafzily[list_tafzily.length-1];
                    url = "../suggest/compar12_suggest_1.php";
                    break;
                case '_compar22_url':
                    url = "../suggest/compar22_suggest_1.php";
                    break;
                case '_compar14_url':
                    var n=e.target.name;
                    var list_tafzily=n.split('_');
                    var index_tafzily=list_tafzily[list_tafzily.length-1];
                    url = "../suggest/compar14_suggest_1.php";
                    break;
                case '_compar24_url':
                    url = "../suggest/compar24_suggest_1.php";
                    break;
                case '_compar15_url':
                    var n=e.target.name;
                    var list_tafzily=n.split('_');
                    var index_tafzily=list_tafzily[list_tafzily.length-1];
                    url = "../suggest/compar15_suggest_1.php";
                    break;
                case '_compar25_url':
                    url = "../suggest/compar25_suggest_1.php";
                    break;
                case '_compar14_2_url':
                    var n=e.target.name;
                    var list_tafzily=n.split('_');
                    var index_tafzily=list_tafzily[list_tafzily.length-1];
                    url = "../suggest/compar14_2_suggest_1.php";
                    break;
                case '_compar24_2_url':
                    url = "../suggest/compar24_2_suggest_1.php";
                    break;
                case '_compar15_2_url':
                    var n=e.target.name;
                    var list_tafzily=n.split('_');
                    var index_tafzily=list_tafzily[list_tafzily.length-1];
                    url = "../suggest/compar15_2_suggest_1.php";
                    break;
                case '_compar25_2_url':
                    url = "../suggest/compar25_2_suggest_1.php";
                    break;
            }
            //alert('before='+kind_fill);

            $.post(url, {
                queryString: inputString,
                kind_fill: kind_fill,
                send_account_incoming: send_account_incoming,
                lang_align: lang_align,
                _language: _language,
                index_tafzily: index_tafzily
            }, function (data)
            {
                //-----------------------------------------
                if(data.counter == 0)//یعنی هیچ دیتایی نیست
                {
                    $("#"+myfield.name).removeClass("loading");
                    fill_1(data.name_val,0,0,txt_st,2,kind_fill,index_tafzily);// یعنی برو کلاس error را نشان بده
                }
                else
                {
                    if(data.counter == 10)//یعنی تعداد دیتا بیش از یک رکورد است
                    {
                        $("#"+myfield.name).removeClass("loading");
                        $('#suggestions').fadeIn();
                        //--------------------------------------------------
                    	var offset_top = $("#"+myfield.name).offset().top+27;
                    	var offset_left = $("#"+myfield.name).offset().left-110;
                    	$("div.suggestionsBox").css({"top":offset_top,"left":offset_left});
                        //-----------------------------------------
                        $('#suggestionsList').html(data.data_rsv);
                        $(".suggestionList ul li").hover(
                            function(){
                                $(this).css({'background-color':'#FFFF00','font-weight':'bold'}); 
                            },
                            function(){
                                $(this).css({'background-color':'#F0F8FF','font-weight':'normal'}); 
                            }
                        );
                    }
                    else // یعنی دیتا یکی است
                    {
                        //$("#"+myfield.name).removeClass("loading");
                        //alert(data.data_rsv+"=="+data.id_val+"=="+data.code_val+"==("+txt_st+")");
                        fill_1(data.data_rsv,data.id_val,data.code_val,txt_st,1,1,index_tafzily);
                    }           
                }                   
            },"json");
        }
        else
        {
            $("#"+myfield.name).removeClass("loading");
            get_child(key);    
        }
    }
}
