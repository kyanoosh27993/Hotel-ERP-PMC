function code_func_storage(e, o, koll, moein ,tafzili,Storage_Barcode)
{
    var evt = e || window.event;
    var key = evt.keyCode;

    var max_length=koll+moein+tafzili+2;
    var kol_moein=koll+moein+1;
    //-------
    o.style.direction = 'rtl';
    o.maxLength = max_length;

    if (Storage_Barcode==1)
    {
        return true;
    }
    else
    {
        if
        (
            (key >= 48 && key <= 57)  ||
            (key >= 96 && key <= 105) ||
            (key == 8 || key == 37 || key == 39 || key == 109 || key == 46  || key == 189 || key == 9 || key == 13 || key == 120 ||
                key == 38 || key == 40 || key == 36 || key == 35 || key == 34 || key == 33 || key == 27 || key == 45 || key == 112 || key == 113
            ))
        {
            if( o.value.length == koll && o.value != ',' && key != 8 && key != 46)
            {
                o.value = o.value + ",";
            }
            if( o.value.length == kol_moein && o.value != ',' && key != 8 && key != 46)
            {
                o.value = o.value + ",";
            }
            return true;
        }
        else
        {
            return false;
        }
    }
}

function code_func(e, o, kind, mynes)
{
    var evt = e || window.event;
    var key = evt.keyCode;
    //-------
    if(kind)
    {
        o.style.direction = 'rtl';
        o.maxLength = 11;
    }
    /* 
        8  -> backspace
        9  -> tab
        13 -> Enter
        37 -> left arrow
        39 -> right arrow
        46 -> delete key
        
        48 -> sefre balaye keyboard labtop va keyboardha
        |
        ^
        57 -> nohe balaye keyboard labtop va keyboardha

        96 -> sefre kenare keyboard pc
        |
        ^
        105 -> nohe kenare keyboard pc
        
    */
    if(mynes)
    {
        if
        (
            (key >= 48 && key <= 57)  ||
            (key >= 96 && key <= 105) ||
            (key == 8 || key == 37 || key == 39 || key == 46  || key == 189 || key == 9 || key == 13 || key == 120 ||
                key == 38 || key == 40 || key == 36 || key == 35 || key == 34 || key == 33 || key == 27 || key == 45 || key == 112 || key == 113
            )
        )
        {


            if(kind)
            {
                if( o.value.length == 2 && o.value != ',' && key != 8 && key != 46)
                {
                    o.value = o.value + ",";
                }
                if( o.value.length == 6 && o.value != ',' && key != 8 && key != 46)
                {
                    o.value = o.value + ",";
                }
            }
            return true;
        }
        else
        {
            return false;
        }
    }
    else
    {
        if
        (
            (key >= 48 && key <= 57)  ||
            (key >= 96 && key <= 105) ||
            (key == 8 || key == 37 || key == 39 || key == 109 || key == 46  || key == 189 || key == 9 || key == 13 || key == 120 ||
                key == 38 || key == 40 || key == 36 || key == 35 || key == 34 || key == 33 || key == 27 || key == 45 || key == 112 || key == 113
            )
        )
        {
            if(kind)
            {
                if( o.value.length == 2 && o.value != ',' && key != 8 && key != 46)
                {
                    o.value = o.value + ",";
                }
                if( o.value.length == 6 && o.value != ',' && key != 8 && key != 46)
                {
                    o.value = o.value + ",";
                }
            }
            return true;
        }
        else
        {
            return false;
        }
    }
}

