function none_enter(e)
{
    var evt = e || window.event;
    var key = e.which;

    if(key == 13)
    {
        return false;
    }
}
//-------------------------
function onlycode(myfield,e)
{
    /*
	var key;
	if (window.event)
   		key = window.event.keyCode;
	else
   		if (e)
        	key = e.which;
	*/
    var evt = e || window.event;
    var key = evt.keyCode;
    //------------
    if (key == 13)
    {
        //alert(' برای حرکت بین خطوط استفاده نمائید TAB لطفا از کلید ');
        return true;
    }
    //----------------------------------------------------
    if((myfield.value).length== 2 && (myfield.value)!=',')
    {
        if((myfield.value+",").length<= myfield.maxLength)
            myfield.value =myfield.value+",";
    }

    if((myfield.value).length== 6 && (myfield.value)!=',')
    {
        if((myfield.value+",").length<= myfield.maxLength)
            myfield.value =myfield.value+",";
    }

    //key=44 =>','
    //key=47 =>'/'
    //48='0' and 57='9'

    if
    (
        (key >= 48 && key <= 57)  ||
        (key >= 96 && key <= 105) ||
        (key == 8 || key == 37 || key == 39 || key == 46 || key == 109 || key == 189 || key == 9 || key == 13 || key == 110 || key == 190)
    )
    {
        return true;
    }
    else
    {
        return false;
    }}
//----------------------
function num_func(o, e)
{
    var evt = e || window.event;
    var key = evt.keyCode;
    /*
        8  -> backspace
        9  -> tab
        13 -> Enter
        37 -> left arrow
        39 -> right arrow
        46 -> delete key

        48 -> sefre balaye keyboard labtop va keyboardha
        |
        ^
        57 -> nohe balaye keyboard labtop va keyboardha

        96 -> sefre kenare keyboard pc
        |
        ^
        105 -> nohe kenare keyboard pc

    */
    if
    (
        !evt.shiftKey && (
            (key >= 48 && key <= 57)  ||
            (key >= 96 && key <= 105) ||
            (key == 8 || key == 37 || key == 39 || key == 46 || key == 109 || key == 189 || key == 9 || key == 13 || key == 110 || key == 190 || key == 173))
    )
    {
        return true;
    }
    else
    {
        return false;
    }
}
