model Warehouse {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code   String  @unique
  nameEn String
  nameFa String
  active Boolean @default(true)

  stockItems StockItem[]
  movements  StockMovement[]
  counts     StockCount[]

  @@map("warehouses")
}

model StockItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String  @unique
  nameEn           String
  nameFa           String
  category         String  @default("OTHER")
  unitPurchase     String  @default("عدد") // واحد خرید
  unitConsumption  String  @default("عدد") // واحد مصرف
  conversionFactor Decimal @default(1) @db.Decimal(12, 4) // تعداد واحد مصرف در یک واحد خرید
  minQty           Decimal @default(0) @db.Decimal(12, 3) // نقطه سفارش مجدد
  qtyOnHand        Decimal @default(0) @db.Decimal(12, 3) // موجودی جاری از گردش قطعی
  avgCostRials     BigInt  @default(0) // میانگین موزون (سیاست مصوب)
  warehouseId      String? @db.Uuid
  allowNegative    Boolean @default(true) // منفی فقط با مجوز صریح
  active           Boolean @default(true)

  warehouse   Warehouse?                @relation(fields: [warehouseId], references: [id])
  movements   StockMovement[]
  recipeLines RecipeLine[]
  reqLines    PurchaseRequisitionLine[] @relation("reqLines")
  poLines     PurchaseOrderLine[]       @relation("poLines")
  countLines  StockCountLine[]          @relation("countLines")

  @@index([qtyOnHand, minQty])
  @@map("stock_items")
}

model StockMovement {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockItemId   String            @db.Uuid
  warehouseId   String            @db.Uuid
  direction     MovementDirection
  qty           Decimal           @db.Decimal(12, 3)
  unitCostRials BigInt
  valueRials    BigInt
  refModule     String // procurement | restaurant | stores
  refId         String?
  note          String?
  createdById   String?           @db.Uuid
  createdAt     DateTime          @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([stockItemId, createdAt])
  @@index([refModule, refId])
  @@map("stock_movements")
}

enum MovementDirection {
  IN
  OUT
  ADJUST_IN
  ADJUST_OUT
  WASTE

  @@map("movement_direction")
}

model Supplier {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String  @unique
  nameEn     String
  nameFa     String
  phone      String?
  ledgerCode String  @default("2101")
  active     Boolean @default(true)

  orders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseRequisition {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reqNo         String            @unique // REQ-<jy>-<seq>
  status        RequisitionStatus @default(DRAFT)
  requestedById String?           @db.Uuid
  decidedById   String?           @db.Uuid
  decidedAt     DateTime?
