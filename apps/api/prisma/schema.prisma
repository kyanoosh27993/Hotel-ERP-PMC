enum LaundryStatus {
  OPEN
  CLOSED

  @@map("laundry_status")
}

model LaundryMovement {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId      String   @db.Uuid
  linenItemId  String   @db.Uuid
