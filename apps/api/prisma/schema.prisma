// ── موج ۳ — فاز ۹ (F9-T2): ادغام مؤدیان — صورتحساب الکترونیکی ──
model MoadianInvoice {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber   String    @unique // INV-YY-NNNNNN — از توالی seq_invoice_number
  journalEntryId  String    @db.Uuid // سند فروش مبدأ (قطعی، POSTED)
  sellerTaxId     String
  buyerTaxId      String    @default("")
  buyerName       String    @default("")
  issueDate       DateTime  @db.Date
  status          String    @default("DRAFT") // DRAFT|QUEUED|SENT|ACCEPTED|REJECTED|CANCELLED
  header          Json      @default("{}") // پاکت هدر مؤدیان
  body            Json      @default("[]") // سطرهای صورتحساب
  totalRials      BigInt    @default(0)
  vatRials        BigInt    @default(0)
  discountRials   BigInt    @default(0)
  uid             String?   // شمارهٔ مرجع مؤدیان
  idempotencyKey  String    @unique // کلید ارسال تکرارپذیر
  attempts        Int       @default(0)
  lastError       String?
  lastResponse    Json?
  submittedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, issueDate])
  @@index([journalEntryId])
  @@map("moadian_invoices")
}

// ── موج ۳ — فاز ۸ (F8-T6): موتور گردش کار تأیید چندمرحله‌ای + امضای الکترونیکی ──
model WorkflowDef {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code    String  @unique // WF-JOURNAL-POST
  title   String
  steps   Json // آرایهٔ [{order, title, permission, minApprovers, selfApproval}]
  version Int     @default(1)
  active  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instances WorkflowInstance[]

  @@map("workflow_defs")
}

model WorkflowInstance {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  defId          String    @db.Uuid
  entityType     String // journal_entry | payroll_run | moadian_invoice | purchase_order | ...
  entityId       String    @db.Uuid
  title          String
  status         String    @default("IN_PROGRESS") // IN_PROGRESS|APPROVED|REJECTED|CANCELLED
  currentStep    Int       @default(1)
  initiatedById  String?   @db.Uuid
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  def    WorkflowDef      @relation(fields: [defId], references: [id])
  actions WorkflowAction[]

  @@unique([entityType, entityId])
  @@index([status])
  @@map("workflow_instances")
}

model WorkflowAction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId String   @db.Uuid
  stepNo     Int
  action     String   // APPROVE | REJECT
  actorId    String?  @db.Uuid
  actorName  String   @default("")
  comment    String   @default("")
  signature  String // HMAC-SHA256 امضای الکترونیکی
  prevHash   String // هش اقدام قبلی (GENESIS برای اولین)
  hash       String // SHA256(prevHash|signature|action|actorId) — زنجیرهٔ ضد دست‌کاری
  at         DateTime @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, stepNo])
  @@map("workflow_actions")
}

// ── موج ۳ — فاز ۹ (F9-T4): معاملات فصلی خارج از سامانه + فایل استاندارد اداره دارایی ──
model QuarterlyPeriod {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxYear            Int // سال مالیاتی شمسی (۱۴۰۵)
  quarter            Int // ۱..۴
  status             String    @default("OPEN") // OPEN | CLOSED
  workflowInstanceId String?   @db.Uuid
  closedAt           DateTime?
  closedById         String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  txs QuarterlyTx[]

  @@unique([taxYear, quarter])
  @@map("quarterly_periods")
}

model QuarterlyTx {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodId         String   @db.Uuid
  txType           String // SALE | PURCHASE
  counterpartyName String
  counterpartyTin  String   @default("-") // شناسهٔ ملی (۱۰) یا کد اقتصادی (۱۲) یا '-' ناشناس
  amountRials      BigInt
  vatRials         BigInt
  txDate           DateTime
  exempt           Boolean  @default(false)
  sourceType       String   @default("MANUAL") // MANUAL | POS
  docRef           String // مرجع سند — یکتا در هر فصل
  notes            String   @default("")
  registeredById   String?  @db.Uuid
  createdAt        DateTime @default(now())

  period QuarterlyPeriod @relation(fields: [periodId], references: [id])

  @@unique([periodId, docRef])
  @@index([periodId, txType])
  @@map("quarterly_txs")
}

// ── موج ۳ — فاز ۹ (F9-T5): مالیات مستقیم — برنامهٔ عملکرد، اظهارنامه، شناسهٔ طرف‌های معامله ──
model DirectTaxPlan {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxYear       Int // سال مالیاتی شمسی — یکتا
  planJson      Json // ظرفیت اتاق، نرخ اشغال هدف، درآمد هدف به تفکیک بخش، اشتغال
  status        String    @default("DRAFT") // DRAFT | CONFIRMED
  confirmedAt   DateTime?
  confirmedById String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([taxYear])
  @@map("direct_tax_plans")
}

model DirectTaxReturn {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxYear            Int // سال مالیاتی شمسی — یکتا
  revenueRials       BigInt    @default(0) // جمع درآمد (۴۱۰۱..۴۱۰۳ بستانکار) اسناد قطعی سال
  costRials          BigInt    @default(0) // جمع هزینه‌های قابل قبول (۵۱۰۱..۵۱۰۴، ۵۲۰۱)
  taxableIncomeRials BigInt    @default(0) // درآمد مشمول = max(0, درآمد − هزینه)
  taxRatePercent     Int       @default(0) // نرخ از کتابخانهٔ قوانین (ماده ۱۰۵)
  taxDueRials        BigInt    @default(0) // مالیات متعلق
  prepaidRials       BigInt    @default(0) // مالیات حقوق کسرشده (بستانکار ۲۲۰۳ سال)
  payableRials       BigInt    @default(0) // بدهی قابل پرداخت = max(0, متعلق − پیش‌پرداخت)
  linesJson          Json      @default("{}") // تفکیک حساب‌ها — رد پای محاسبه
  status             String    @default("DRAFT") // DRAFT | SUBMITTED
  workflowInstanceId String?   @db.Uuid
  submittedAt        DateTime?
  submittedById      String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([taxYear])
  @@map("direct_tax_returns")
}

// ── موج ۴ — فاز ۱۱: BI کامل و هوش مصنوعی گسترده ──
model BiBudget {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxYear        Int // سال مالیاتی شمسی
  periodCode     String // '1405-09' ماهانه یا '1405-Q3'
  costCenterCode String // CC-ROOMS | CC-FB | CC-ADMIN | ...
  revenueRials   BigInt   @default(0) // بودجهٔ درآمد
  costRials      BigInt   @default(0) // بودجهٔ هزینه
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([taxYear, periodCode, costCenterCode])
  @@map("bi_budgets")
}

model AiRateSuggestion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomTypeCode   String
  businessDate   DateTime  @db.Date
  baseRials      BigInt // نرخ پایهٔ فعلی نوع اتاق
  suggestedRials BigInt // نرخ پیشنهادی
  confidenceLow  BigInt // کران پایین اطمینان
  confidenceHigh BigInt // کران بالا
  reasonJson     Json      @default("{}") // روند/ضریب‌ها — ردپای محاسبه
  status         String    @default("DRAFT") // DRAFT | APPROVED | REJECTED — بدون اثر خودکار
  createdById    String?   @db.Uuid
  decidedById    String?   @db.Uuid
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([businessDate])
  @@map("ai_rate_suggestions")
}

model AiDocDraft {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceText        String    @db.Text // متن استخراج‌شدهٔ فاکتور/سند
  extractedJson     Json      @default("{}") // مبلغ/مالیات/فروشنده/تاریخ — خروجی قواعد
  suggestedLinesJson Json     @default("[]") // سطرهای پیشنهادی سند
  status            String    @default("DRAFT") // DRAFT | DRAFTED | DISCARDED — هیچ‌گاه قطعی نمی‌شود
  draftEntryId      String?   @db.Uuid // سند پیش‌نویس حسابداری (تأیید انسانی لازم دارد)
  createdById       String?   @db.Uuid
  approvedById      String?   @db.Uuid
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("ai_doc_drafts")
}

// ── موج ۵ — فاز ۱۲ (F12-T4): API Marketplace — کلیدهای مشتریان ──
model ApiClient {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String // نام مشتری/پارتنر
  keyPrefix      String    @unique // ۸ نویسهٔ اول کلید — نمایش و جستجو (کلید کامل هرگز ذخیره نمی‌شود)
  apiKeyHash     String // SHA-256 کلید — تطبیق بدون ذخیرهٔ متن آشکار
  scopes         Json      @default("[]") // ["availability","rates","reservations"]
  rateLimitPerMin Int      @default(60) // محدودسازی نرخ در هر دقیقه
  active         Boolean   @default(true)
  lastUsedAt     DateTime?
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("api_clients")
}
