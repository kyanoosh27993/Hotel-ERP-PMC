  journalEntryNo   String?
  postedAt         DateTime @default(now())
  idempotencyKey   String   @unique

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, periodCode])
  @@map("asset_depreciations")
}

