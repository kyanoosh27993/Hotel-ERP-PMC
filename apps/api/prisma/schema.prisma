}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELED

  @@map("maintenance_status")
}

model LinenItem {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code   String  @unique
  nameEn String
  nameFa String
