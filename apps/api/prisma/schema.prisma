// schema.prisma — هسته فاز ۱ (قواعد ۱۲گانه سند ۰۴)
// ریال = BigInt صحیح (قاعده ۷) | UUID پایه (قاعده ۱) | اسناد مالی حذف فیزیکی ندارند (قاعده ۳)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── IAM ─────────────────────────

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String   @unique
  passwordHash String
  fullName     String
  email        String?  @unique
  mfaSecret    String?
  mfaEnabled   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  createdEntries JournalEntry[] @relation("EntryCreator")
  approvedEntries JournalEntry[] @relation("EntryApprover")

  @@map("users")
}

model Role {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String  @unique // admin | accountant | approver | front_desk | ...
  displayNameEn  String
  displayNameFa  String
  sensitiveMfa   Boolean @default(false) // ورود این نقش نیاز به MFA دارد

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String @unique
  descriptionEn String
  descriptionFa String

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String @db.Uuid
  roleId    String @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique // SHA-256 — توکن خام هرگز ذخیره نمی‌شود
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedById String? @db.Uuid
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ───────────────────────── حسابرسی (تغییرناپذیر) ─────────────────────────

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @db.Uuid
  action    String // LOGIN | LOGIN_FAILED | CREATE | UPDATE | APPROVE | REVERSE | ...
  entity    String
  entityId  String?
  beforeJson Json?
  afterJson  Json?
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation("AuditActor", fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ───────────────────────── Outbox / Inbox ─────────────────────────

model OutboxEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventName      String
  aggregate      String
  producer       String
  version        Int       @default(1)
  idempotencyKey String    @unique
  payload        Json
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?

  @@index([publishedAt, nextAttemptAt])
  @@map("outbox_events")
}

model InboxEvent {
  idempotencyKey String   @id
  eventName      String
  processedAt    DateTime @default(now())
  resultJson     Json?

  @@map("inbox_events")
}

// ───────────────────────── رزرو و اتاق (PoC) ─────────────────────────

model RoomType {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String  @unique
  nameEn         String
  nameFa         String
  capacity       Int     @default(2)
  baseRateRials  BigInt

  rooms        Room[]
  reservations Reservation[]
  waitlistEntries WaitlistEntry[]

  @@map("room_types")
}

model Room {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String  @unique
  roomTypeId String  @db.Uuid
  floor      Int     @default(1)
  status     RoomStatus @default(AVAILABLE)
  hkStatus   HousekeepingStatus @default(CLEAN) // F4-T7 وضعیت نظافت
  note       String? // یادداشت تعمیر/نگهداری (F4-T1)

  roomType RoomType @relation(fields: [roomTypeId], references: [id])
  stayRooms StayRoom[]
  tasks RoomTask[]
  inspections RoomInspection[]
  maintenanceRequests MaintenanceRequest[]
  lostFound LostAndFound[]
  fixedAssets FixedAsset[]

  @@index([status, hkStatus])
  @@map("rooms")
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  OUT_OF_SERVICE

  @@map("room_status")
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  IN_PROGRESS
  INSPECTED

  @@map("housekeeping_status")
}

model Reservation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String   @unique // RSV-<jy>-<seq>
  roomTypeId     String   @db.Uuid
  guestName      String
  checkIn        DateTime @db.Date
  checkOut       DateTime @db.Date
  nights         Int
  totalRials     BigInt
  status         ReservationStatus @default(CONFIRMED)
  idempotencyKey String   @unique
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())
  cancelledAt    DateTime?

  roomType RoomType @relation(fields: [roomTypeId], references: [id])
  source   ReservationSource @default(PHONE) // F4-T2 کانال رزرو
  groupName String?
  adults   Int @default(1)
  children Int @default(0)
  note     String?
  stays    Stay[]

  @@index([roomTypeId, checkIn, checkOut, status])
  @@map("reservations")
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT

  @@map("reservation_status")
}

enum ReservationSource {
  PHONE
  WALK_IN
  ONLINE
  OTA

  @@map("reservation_source")
}

// ─────────────────── فاز ۴ — PMS: لیست انتظار، اقامت، حسابرسی شبانه ───────────────────

model WaitlistEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guestName  String
  phone      String?
  roomTypeId String   @db.Uuid
  fromDate   DateTime @db.Date
  toDate     DateTime @db.Date
  status     WaitlistStatus @default(WAITING)
  note       String?
  createdById String? @db.Uuid
  createdAt  DateTime @default(now())

  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@index([status, fromDate])
  @@map("waitlist_entries")
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  CANCELLED

  @@map("waitlist_status")
}

model Stay {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String  @unique // STY-<yyyy>-<seq>
  reservationId   String? @db.Uuid
  guestName       String
  adults          Int     @default(1)
  children        Int     @default(0)
  status          StayStatus @default(OPEN)
  checkInAt       DateTime @default(now())
  plannedCheckOut DateTime @db.Date
  actualCheckOutAt DateTime?
  folioRials      BigInt  @default(0) // جمع شارژ اتاق در خروج
  idempotencyKey  String  @unique
  createdById     String? @db.Uuid
  createdAt       DateTime @default(now())

  reservation Reservation? @relation(fields: [reservationId], references: [id])
  rooms StayRoom[]
  cashTransactions CashTransaction[]
  ancillaryOrders AncillaryOrder[]

  @@index([status, plannedCheckOut])
  @@map("stays")
}

enum StayStatus {
  OPEN
  CLOSED

  @@map("stay_status")
}

model StayRoom {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stayId   String  @db.Uuid
  roomId   String  @db.Uuid
  rateOverrideRials BigInt? // نرخ توافقی گروهی؛ null = نرخ پایه نوع اتاق

  stay Stay @relation(fields: [stayId], references: [id])
  room Room  @relation(fields: [roomId], references: [id])

  @@unique([stayId, roomId])
  @@index([roomId])
  @@map("stay_rooms")
}

model NightAuditRun {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessDate DateTime @db.Date @unique
  status       AuditStatus @default(OK)
  openStays    Int      @default(0)
  dirtyRooms   Int      @default(0)
  arrivalsNotCheckedIn Int @default(0)
  exceptions   Json
  closedAt     DateTime @default(now())
  closedById   String?  @db.Uuid

  @@map("night_audit_runs")
}

enum AuditStatus {
  OK
  WITH_EXCEPTIONS

  @@map("audit_status")
}

// ───────────────────────── POS (PoC) ─────────────────────────

model PosOutlet {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code   String @unique
  nameEn String
  nameFa String

  orders PosOrder[]

  @@map("pos_outlets")
}

model PosOrder {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String   @unique // ORD-<jy>-<seq>
  outletId       String   @db.Uuid
  totalRials     BigInt
  taxRials       BigInt
  status         String   @default("SERVED")
  linesJson      Json
  folioId        String?  @db.Uuid
  idempotencyKey String   @unique
  servedById     String?  @db.Uuid
  servedAt       DateTime @default(now())

  outlet PosOutlet @relation(fields: [outletId], references: [id])

  @@map("pos_orders")
}

// ───────────────────────── حسابداری هسته ─────────────────────────

model Account {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String  @unique
  nameEn     String
  nameFa     String
  type       AccountType
  isSensitive Boolean @default(false) // ویرایش فقط با مجوز sensitive_accounts.edit
  parentCode String?

  lines JournalLine[]

  @@map("accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@map("account_type")
}

model FiscalPeriod {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique // مثال: 1405-09
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  status    FiscalPeriodStatus @default(OPEN)
  lockedAt  DateTime?

  entries JournalEntry[]

  @@map("fiscal_periods")
}

enum FiscalPeriodStatus {
  OPEN
  LOCKED

  @@map("fiscal_period_status")
}

model JournalEntry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryNo      String   @unique // JV-1405-000001
  entryDate    DateTime @db.Date
  postingDate  DateTime @db.Date
  periodId     String?  @db.Uuid
  description  String
  status       JournalStatus @default(DRAFT)
  sourceModule String
  sourceRef    String
  sourceEventId String? @db.Uuid
  reversedByEntryId String? @db.Uuid
  createdById  String?  @db.Uuid
  approvedById String?  @db.Uuid
  approvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  period     FiscalPeriod? @relation(fields: [periodId], references: [id])
  createdBy  User?         @relation("EntryCreator", fields: [createdById], references: [id])
  approvedBy User?         @relation("EntryApprover", fields: [approvedById], references: [id])
  lines      JournalLine[]

  @@index([sourceModule, sourceRef])
  @@index([status])
  @@map("journal_entries")
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED

  @@map("journal_status")
}

model JournalLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId        String  @db.Uuid
  lineNo         Int
  accountCode    String
  debitRials     BigInt  @default(0)
  creditRials    BigInt  @default(0)
  costCenterCode String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account Account      @relation(fields: [accountCode], references: [code])

  @@index([entryId])
  @@map("journal_lines")
}

// ───────────────────────── موتور سند خودکار (نگاشت رویداد←سند، پارامتریک) ─────────────────────────

model EventJournalRule {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId           String  @unique // res_confirmed | pos_served ...
  eventName        String  @unique
  descriptionFa    String
  linesJson        Json // [{accountCode, side: 'debit'|'credit', amountKind: 'total'|'tax'|'net'}]
  isActive         Boolean @default(true)

  @@map("event_journal_rules")
}

// ───────────────────────── حقوق و دستمزد (فاز ۲ — F2-T1…T4) ─────────────────────────

model Employee {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String    @unique
  firstName   String
  lastName    String
  nationalId  String?   @unique
  iban        String?
  marital     Boolean   @default(false)
  dependents  Int       @default(0)
  hireDate    DateTime? @db.Date
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  decisions SalaryDecision[]
  slips     PayrollSlip[]

  @@map("employees")
}

model SalaryDecision {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String         @db.Uuid
  baseSalary   BigInt
  seniority    BigInt         @default(0)
  housing      BigInt         @default(0)
  effectiveFrom DateTime      @db.Date
  status       DecisionStatus @default(DRAFT)
  note         String?
  createdById  String?        @db.Uuid
  approvedById String?        @db.Uuid
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom, status])
  @@map("salary_decisions")
}

enum DecisionStatus {
  DRAFT
  APPROVED

  @@map("decision_status")
}

model PayrollRun {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodCode        String           @unique // '1405-09'
  status            PayrollRunStatus @default(DRAFT)
  paramsVersion     String
  grossRials        BigInt           @default(0)
  netRials          BigInt           @default(0)
  taxRials          BigInt           @default(0)
  insEmployeeRials  BigInt           @default(0)
  insEmployerRials  BigInt           @default(0)
  employeeCount     Int              @default(0)
  skippedJson       Json?
  journalEntryId    String?          @db.Uuid
  createdById       String?          @db.Uuid
  approvedById      String?          @db.Uuid
  approvedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  slips PayrollSlip[]

  @@map("payroll_runs")
}

enum PayrollRunStatus {
  DRAFT
  APPROVED

  @@map("payroll_run_status")
}

model PayrollSlip {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId          String @db.Uuid
  employeeId     String @db.Uuid
  mizanRials     BigInt @default(0)
  dailyRials     BigInt @default(0)
  hourlyRials    BigInt @default(0)
  overtimeRials  BigInt @default(0)
  nightRials     BigInt @default(0)
  housingRials   BigInt @default(0)
  childAllowRials BigInt @default(0)
  absentRials    BigInt @default(0)
  grossRials     BigInt @default(0)
  insEmployeeRials BigInt @default(0)
  insEmployerRials BigInt @default(0)
  monthlyTaxableRials BigInt @default(0)
  annualTaxableRials  BigInt @default(0)
  taxRials       BigInt @default(0)
  netRials       BigInt @default(0)
  overridesJson  Json?
  paramsVersion  String

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@map("payroll_slips")
}

// ───────────────────────── فاز ۵ — صندوق، پرداخت و خزانه‌داری (نقشه ۷.۲) ─────────────────────────

model CashAccount {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String @unique // CH-01 صندوق پذیرش، BN-01 بانک ملت…
  nameEn        String
  nameFa        String
  kind          CashAccountKind
  glAccountCode String // حساب کل متصل (۱۱۰۱ صندوق / ۱۱۰۲ بانک) — بدون FK، با seed کنترل می‌شود
  active        Boolean @default(true)
  createdAt     DateTime @default(now())

  shifts         CashierShift[]
  transactions   CashTransaction[]
  statementLines BankStatementLine[]
  reconciliations ReconciliationRun[]

  @@map("cash_accounts")
}

enum CashAccountKind {
  CASH_DRAWER
  BANK

  @@map("cash_account_kind")
}

model CashierShift {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String  @unique // SHF-<jy>-<seq>
  cashAccountId     String  @db.Uuid
  businessDate      DateTime @db.Date
  openingFloatRials BigInt  @default(0)
  countedRials      BigInt?
  varianceRials     BigInt?
  status            CashShiftStatus @default(OPEN)
  note              String?
  openedById        String? @db.Uuid
  openedAt          DateTime @default(now())
  closedAt          DateTime?

  cashAccount CashAccount       @relation(fields: [cashAccountId], references: [id])
  transactions CashTransaction[]

  @@index([cashAccountId, status])
  @@map("cashier_shifts")
}

enum CashShiftStatus {
  OPEN
  CLOSED

  @@map("cash_shift_status")
}

model CashTransaction {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  txnNo               String @unique // TXN-<jy>-<seq>
  cashAccountId       String @db.Uuid
  shiftId             String? @db.Uuid
  kind                CashTxnKind
  method              CashTxnMethod
  amountRials         BigInt // همیشه مثبت؛ جهت با kind
  traceNo             String? // شناسه پیگیری بانک/درگاه
  counterGlAccountCode String? // حساب طرف مقابل (پیش‌فرض از seed)
  stayId              String? @db.Uuid // شارژ فولیوی اقامت
  payerName           String?
  note                String?
  businessDate        DateTime @db.Date
  status              CashTxnStatus @default(POSTED)
  idempotencyKey      String @unique
  createdById         String? @db.Uuid
  createdAt           DateTime @default(now())

  cashAccount CashAccount  @relation(fields: [cashAccountId], references: [id])
  shift       CashierShift? @relation(fields: [shiftId], references: [id])
  stay        Stay?         @relation(fields: [stayId], references: [id])

  @@index([cashAccountId, businessDate])
  @@index([kind, status])
  @@map("cash_transactions")
}

enum CashTxnKind {
  RECEIPT
  PAYMENT
  TRANSFER
  REFUND
  ADJUSTMENT

  @@map("cash_txn_kind")
}

enum CashTxnMethod {
  CASH
  CARD
  TRANSFER
  ONLINE

  @@map("cash_txn_method")
}

enum CashTxnStatus {
  POSTED
  VOID

  @@map("cash_txn_status")
}

model BankStatementLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cashAccountId  String   @db.Uuid
  valueDate      DateTime @db.Date
  externalRef    String // شماره سند بانک
  description    String
  debitRials     BigInt   @default(0)
  creditRials    BigInt   @default(0)
  matchedTxnId   String?  @db.Uuid
  matchedAt      DateTime?
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())

  cashAccount CashAccount @relation(fields: [cashAccountId], references: [id])

  @@unique([cashAccountId, externalRef])
  @@index([cashAccountId, valueDate])
  @@map("bank_statement_lines")
}

model ReconciliationRun {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cashAccountId  String   @db.Uuid
  runDate        DateTime @db.Date
  matchedCount   Int      @default(0)
  unmatchedCount Int      @default(0)
  note           String?
  closedById     String?  @db.Uuid
  closedAt       DateTime @default(now())

  cashAccount CashAccount @relation(fields: [cashAccountId], references: [id])

  @@index([cashAccountId, runDate])
  @@map("reconciliation_runs")
}

// ───────────────────────── فاز ۱۰ — خانه‌داری، لاندری و تعمیرات (نقشه ۷.۴) ─────────────────────────

model RoomTask {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId       String   @db.Uuid
  kind         RoomTaskKind
  status       RoomTaskStatus @default(PENDING)
  priority     TaskPriority @default(NORMAL)
  assigneeId   String?  @db.Uuid
  scheduledDate DateTime @db.Date
  startedAt    DateTime?
  doneAt       DateTime?
  note         String?
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])

  @@index([roomId, status])
  @@index([scheduledDate, status])
  @@map("room_tasks")
}

enum RoomTaskKind {
  CLEANING
  TURNDOWN
  INSPECTION
  MAINTENANCE_FOLLOWUP

  @@map("room_task_kind")
}

enum RoomTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELED

  @@map("room_task_status")
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("task_priority")
}

model RoomInspection {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId         String   @db.Uuid
  taskId         String?  @db.Uuid
  passed         Boolean
  score          Int?
  issuesJson     Json?
  inspectedById  String?  @db.Uuid
  inspectedAt    DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])

  @@index([roomId, inspectedAt])
  @@map("room_inspections")
}

model MaintenanceRequest {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestNo      String   @unique // MNT-<jy>-<seq>
  roomId         String?  @db.Uuid
  assetId        String?  @db.Uuid
  title          String
  description    String
  priority       TaskPriority @default(NORMAL)
  status         MaintenanceStatus @default(OPEN)
  reportedById   String?  @db.Uuid
  assigneeId     String?  @db.Uuid
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  resolutionNote String?
  costRials      BigInt?

  room       Room?        @relation(fields: [roomId], references: [id])
  asset      FixedAsset?  @relation(fields: [assetId], references: [id])

  @@index([status, priority])
  @@map("maintenance_requests")
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELED

  @@map("maintenance_status")
}

model LinenItem {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code   String @unique
  nameEn String
  nameFa String
  unit   String @default("عدد")
  active Boolean @default(true)

  movements LaundryMovement[]

  @@map("linen_items")
}

model LaundryBatch {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String   @unique // LDY-<jy>-<seq>
  direction  LaundryDirection
  status     LaundryStatus @default(OPEN)
  openedAt   DateTime @default(now())
  closedAt   DateTime?
  openedById String?  @db.Uuid

  movements LaundryMovement[]

  @@map("laundry_batches")
}

enum LaundryDirection {
  OUT_WASH
  IN_RETURN

  @@map("laundry_direction")
}

enum LaundryStatus {
  OPEN
  CLOSED

  @@map("laundry_status")
}

model LaundryMovement {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId      String @db.Uuid
  linenItemId  String @db.Uuid
  qty          Int
  recordedById String? @db.Uuid
  recordedAt   DateTime @default(now())

  batch LaundryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  item  LinenItem    @relation(fields: [linenItemId], references: [id])

  @@unique([batchId, linenItemId])
  @@map("laundry_movements")
}

model LostAndFound {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique // LNF-<jy>-<seq>
  roomId          String   @db.Uuid
  itemDesc        String
  foundAt         DateTime @default(now())
  storageLocation String
  status          LostFoundStatus @default(STORED)
  returnedTo      String?
  returnedAt      DateTime?
  note            String?
  foundById       String?  @db.Uuid

  room Room @relation(fields: [roomId], references: [id])

  @@map("lost_and_founds")
}

enum LostFoundStatus {
  STORED
  RETURNED
  DISPOSED

  @@map("lost_found_status")
}

// ───────────────────────── فاز ۱۰ — دارایی ثابت (نقشه ۷.۸) ─────────────────────────

model FixedAsset {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetCode              String   @unique // FA-<seq>
  nameEn                 String
  nameFa                 String
  category               String // FUN | ELE | VEH | FUR | IT | OTHER
  acquiredAt             DateTime @db.Date
  costRials              BigInt
  salvageRials           BigInt   @default(0)
  usefulLifeMonths       Int
  method                 DepreciationMethod @default(STRAIGHT_LINE)
  glAssetAccountCode     String // ۱۵۰۱ دارایی ثابت
  glAccDepAccountCode    String // ۱۵۰۲ استهلاک انباشته
  glDepExpenseAccountCode String // ۵۲۰۱ هزینه استهلاک
  roomId                 String?  @db.Uuid
  status                 AssetStatus @default(ACTIVE)
  note                   String?
  createdById            String?  @db.Uuid
  createdAt              DateTime @default(now())

  room                Room?                  @relation(fields: [roomId], references: [id])
  depreciations       AssetDepreciation[]
  maintenanceRequests MaintenanceRequest[]

  @@map("fixed_assets")
}

enum DepreciationMethod {
  STRAIGHT_LINE

  @@map("depreciation_method")
}

enum AssetStatus {
  ACTIVE
  TRANSFERRED
  SOLD
  SCRAPPED

  @@map("asset_status")
}

model AssetDepreciation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId         String   @db.Uuid
  periodCode      String   // '1405-09'
  amountRials     BigInt
  accumulatedRials BigInt
  journalEntryNo  String?
  postedAt        DateTime @default(now())
  idempotencyKey  String   @unique

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, periodCode])
  @@map("asset_depreciations")
}

// ───────────────────────── فاز ۱۰ — خدمات جانبی (نقشه ۷.۱۰) ─────────────────────────

model AncillaryService {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String  @unique // SVC-PHONE، SVC-PARKING…
  nameEn             String
  nameFa             String
  category           AncillaryCategory
  unitPriceRials     BigInt
  taxRateBps         Int     @default(900) // ۹٪ ارزش افزوده بر حسب basis point
  glRevenueAccountCode String // ۴۱۰۳ درآمد خدمات جانبی
  active             Boolean @default(true)
  createdAt          DateTime @default(now())

  orders AncillaryOrder[]

  @@map("ancillary_services")
}

enum AncillaryCategory {
  PHONE
  PARKING
  TAXI
  POOL
  INTERNET
  SHOP
  CEREMONY
  OTHER

  @@map("ancillary_category")
}

model AncillaryOrder {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNo       String   @unique // SVC-<jy>-<seq>
  serviceId     String   @db.Uuid
  quantity      Int
  unitPriceRials BigInt
  netRials      BigInt
  taxRials      BigInt
  totalRials    BigInt
  stayId        String?  @db.Uuid // شارژ فولیوی اقامت
  guestName     String?
  status        AncillaryOrderStatus @default(CONFIRMED)
  servedAt      DateTime @default(now())
  servedById    String?  @db.Uuid
  idempotencyKey String  @unique
  note          String?

  service AncillaryService @relation(fields: [serviceId], references: [id])
  stay    Stay?            @relation(fields: [stayId], references: [id])

  @@index([serviceId, servedAt])
  @@map("ancillary_orders")
}

enum AncillaryOrderStatus {
  CONFIRMED
  CHARGED
  CANCELED

  @@map("ancillary_order_status")
}
