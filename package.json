{
  "name": "hotel-erp",
  "version": "0.7.1",
  "private": true,
  "description": "Hotel ERP/PMS — Modular Monolith (NestJS + Next.js + PostgreSQL) — فاز ۱ هسته",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web-next"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@yao-pkg/pkg": "^6.26.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:e2e": "npm run test:e2e --if-present -w apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate -w apps/api",
    "prisma:migrate": "npm run prisma:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api"
  }
}
