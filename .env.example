# ── Hotel ERP — نمونه تنظیمات محیط (کپی به .env و مقادیر واقعی بگذارید) ──
# هیچ اعتبارنامه واقعی در این فایل یا در گیت ذخیره نشود (قانون امنیتی).

# ── هسته ──
NODE_ENV=development
PORT=3000
WEB_PORT=3001
API_URL=http://localhost:3000/api/v1

# ── پایگاه داده ──
DATABASE_URL=postgresql://hotel:CHANGE_ME_STRONG@localhost:5432/hotel_erp?schema=public
POSTGRES_USER=hotel
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=hotel_erp

# ── Redis / RabbitMQ ──
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── احراز هویت (این مقادیر فقط نمونه‌اند — در استقرار واقعی عوض کنید) ──
JWT_ACCESS_SECRET=CHANGE_ME_random_64_chars
JWT_REFRESH_SECRET=CHANGE_ME_other_random_64_chars
ACCESS_TOKEN_TTL=900s
REFRESH_TOKEN_TTL_DAYS=14
SEED_ADMIN_PASSWORD=ChangeMe_Str0ng!
MFA_REQUIRED_ROLES=ceo,accountant

# ── رصد (اختیاری) ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
METRICS_ENABLED=true

# ── بکاپ ──
BACKUP_DIR=./backups
BACKUP_PASSPHRASE=CHANGE_ME_backup_passphrase
BACKUP_KEEP_DAYS=30
